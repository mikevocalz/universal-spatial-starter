<Rive version="1" kind="fragment">
  <!--
    game-controls: the /game primary button in Full Rive mode.
    View model GameControls { status: ready|running|paused|over, press: trigger }.
    status picks the label and the fill (Start / Pause / Resume / Play again);
    a click on the button fires the press trigger, which the app observes and turns into
    start, pause or resume. The art never decides what a press means.
  -->
  <Artboard defaultStateMachineId="0:7" viewModelId="0:40" viewModelInstanceId="0:44" styleId="0:5" clip="true" width="240" height="64" name="GameControls" id="0:2">
    <LayoutComponentStyle name="Artboard Style" id="0:5"/>
    <Fill name="Background">
      <SolidColor colorValue="FF16130F" name="Ink"/>
    </Fill>

    <Node x="120" y="32" name="Button" id="0:10">
      <!-- Labels first: the first child declared paints on top. -->

      <Text sizingValue="autoWidth" originX="0.5" originY="0.5" opacity="1" name="Start Label" id="0:20">
        <TextStylePaint fontSize="20" fontAssetId="0:90" familyName="Space Grotesk" styleName="Bold" name="Start Style" id="0:21">
          <TextStyleAxis tag="2003265652" axisValue="700" name="Weight"/>
          <Fill name="Fill"><SolidColor colorValue="FFF4F1EA" name="Mineral"/></Fill>
        </TextStylePaint>
        <TextValueRun styleId="0:21" text="Start" name="Start Run"/>
      </Text>
      <Text sizingValue="autoWidth" originX="0.5" originY="0.5" opacity="0" name="Pause Label" id="0:22">
        <TextStylePaint fontSize="20" fontAssetId="0:90" familyName="Space Grotesk" styleName="Bold" name="Pause Style" id="0:23">
          <TextStyleAxis tag="2003265652" axisValue="700" name="Weight"/>
          <Fill name="Fill"><SolidColor colorValue="FFF4F1EA" name="Mineral"/></Fill>
        </TextStylePaint>
        <TextValueRun styleId="0:23" text="Pause" name="Pause Run"/>
      </Text>
      <Text sizingValue="autoWidth" originX="0.5" originY="0.5" opacity="0" name="Resume Label" id="0:24">
        <TextStylePaint fontSize="20" fontAssetId="0:90" familyName="Space Grotesk" styleName="Bold" name="Resume Style" id="0:25">
          <TextStyleAxis tag="2003265652" axisValue="700" name="Weight"/>
          <Fill name="Fill"><SolidColor colorValue="FFF4F1EA" name="Mineral"/></Fill>
        </TextStylePaint>
        <TextValueRun styleId="0:25" text="Resume" name="Resume Run"/>
      </Text>
      <Text sizingValue="autoWidth" originX="0.5" originY="0.5" opacity="0" name="Again Label" id="0:26">
        <TextStylePaint fontSize="20" fontAssetId="0:90" familyName="Space Grotesk" styleName="Bold" name="Again Style" id="0:27">
          <TextStyleAxis tag="2003265652" axisValue="700" name="Weight"/>
          <Fill name="Fill"><SolidColor colorValue="FFF4F1EA" name="Mineral"/></Fill>
        </TextStylePaint>
        <TextValueRun styleId="0:27" text="Play again" name="Again Run"/>
      </Text>
      <Shape name="Face" id="0:11">
        <Rectangle width="236" height="56" cornerRadiusTL="14" name="Face Path"/>
        <Fill name="Face Fill">
          <SolidColor colorValue="FF0047FF" name="Face Color" id="0:12"/>
        </Fill>
        <Stroke thickness="1.5" name="Face Edge">
          <SolidColor colorValue="FF0047FF" name="Edge Color" id="0:13"/>
        </Stroke>
      </Shape>
    </Node>

    <StateMachine name="Controls" id="0:7">
      <StateMachineListenerSingle targetId="0:11" listenerTypeValue="click" name="Press" id="0:70">
        <ListenerViewModelChange>
          <BindablePropertyTrigger propertyValue="1">
            <DataBindContext sourcePathIds="0:40-0:42" propertyKey="686" direction="true"/>
