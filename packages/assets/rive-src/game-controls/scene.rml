          <StateTransition stateToId="0:33" duration="120"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:41" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="0:53"/></TransitionViewModelCondition></StateTransition>
        </AnimationState>
        <AnimationState x="600" y="0" animationId="0:82" id="0:32">
          <StateTransition stateToId="0:30" duration="120"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:41" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="0:50"/></TransitionViewModelCondition></StateTransition>
