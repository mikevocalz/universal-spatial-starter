          <StateTransition stateToId="0:33" duration="120"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:41" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="0:53"/></TransitionViewModelCondition></StateTransition>
        </AnimationState>
        <AnimationState x="400" y="200" animationId="0:83" id="0:33">
          <StateTransition stateToId="0:30" duration="120"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:41" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="0:50"/></TransitionViewModelCondition></StateTransition>
          <StateTransition stateToId="0:31" duration="120"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:41" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="0:51"/></TransitionViewModelCondition></StateTransition>
          <StateTransition stateToId="0:32" duration="120"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:41" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator><TransitionValueEnumComparator value="0:52"/></TransitionViewModelCondition></StateTransition>
        </AnimationState>
      </StateMachineLayer>
    </StateMachine>

    <!-- Hold poses. Filled cobalt for the actions that move the game forward, outlined for Pause. -->
    <LinearAnimation fps="60" duration="1" name="Start" id="0:80">
      <KeyedObject objectId="0:12"><KeyedProperty propertyKey="37"><KeyFrameColor value="FF0047FF"/></KeyedProperty></KeyedObject>
      <KeyedObject objectId="0:20"><KeyedProperty propertyKey="18"><KeyFrameDouble value="1"/></KeyedProperty></KeyedObject>
      <KeyedObject objectId="0:22"><KeyedProperty propertyKey="18"><KeyFrameDouble value="0"/></KeyedProperty></KeyedObject>
