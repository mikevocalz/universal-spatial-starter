    <ViewModelPropertyNumber name="bandFrom" id="0:42"/>
    <ViewModelPropertyNumber name="bandTo" id="0:43"/>
    <ViewModelPropertyEnumCustom enumId="0:49" name="status" id="0:44"/>
    <ViewModelPropertyNumber name="score" id="0:45"/>
    <ViewModelInstance exports="true" name="Default" id="0:47">
      <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:41"/>
      <ViewModelInstanceNumber propertyValue="0.68" viewModelPropertyId="0:42"/>
      <ViewModelInstanceNumber propertyValue="0.86" viewModelPropertyId="0:43"/>
