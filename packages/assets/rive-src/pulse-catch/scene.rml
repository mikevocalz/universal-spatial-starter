  <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="0" maxOutput="340" clampLower="true" clampUpper="true" name="PhaseToDiameter" id="0:62"/>
  <DataConverterToString decimals="0" round="true" name="ScoreText" id="0:63"/>

