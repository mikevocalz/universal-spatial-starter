  <!-- (bandFrom + bandTo) * 170: band centre diameter. -->
  <DataConverterFormula name="BandDiameter" id="0:60">
    <FormulaTokenParenthesisOpen/>
    <FormulaTokenValue><DataBindContext sourcePathIds="0:40-0:42" propertyKey="777"/></FormulaTokenValue>
    <FormulaTokenOperation operationType="0"/>
    <FormulaTokenValue><DataBindContext sourcePathIds="0:40-0:43" propertyKey="777"/></FormulaTokenValue>
    <FormulaTokenParenthesisClose/>
    <FormulaTokenOperation operationType="2"/>
    <FormulaTokenValue operationValue="170"/>
  </DataConverterFormula>
  <!-- (bandTo - bandFrom) * 170: band stroke thickness. -->
  <DataConverterFormula name="BandThickness" id="0:61">
