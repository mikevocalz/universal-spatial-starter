              <TransitionValueEnumComparator value="0:53"/>
            </TransitionViewModelCondition>
          </StateTransition>
        </AnimationState>
        <AnimationState x="400" y="0" animationId="0:81" id="0:11">
          <StateTransition stateToId="0:10" duration="150">
            <TransitionViewModelCondition>
              <TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:44" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator>
              <TransitionValueEnumComparator value="0:50"/>
            </TransitionViewModelCondition>
          </StateTransition>
          <StateTransition stateToId="0:12" duration="150">
            <TransitionViewModelCondition>
              <TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:44" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator>
              <TransitionValueEnumComparator value="0:52"/>
            </TransitionViewModelCondition>
          </StateTransition>
          <StateTransition stateToId="0:13" duration="150">
            <TransitionViewModelCondition>
              <TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:44" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator>
              <TransitionValueEnumComparator value="0:53"/>
            </TransitionViewModelCondition>
          </StateTransition>
        </AnimationState>
        <AnimationState x="600" y="0" animationId="0:82" id="0:12">
          <StateTransition stateToId="0:10" duration="150">
            <TransitionViewModelCondition>
              <TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:44" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator>
              <TransitionValueEnumComparator value="0:50"/>
            </TransitionViewModelCondition>
          </StateTransition>
          <StateTransition stateToId="0:11" duration="150">
            <TransitionViewModelCondition>
              <TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:44" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator>
              <TransitionValueEnumComparator value="0:51"/>
            </TransitionViewModelCondition>
          </StateTransition>
          <StateTransition stateToId="0:13" duration="150">
            <TransitionViewModelCondition>
              <TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:44" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator>
              <TransitionValueEnumComparator value="0:53"/>
            </TransitionViewModelCondition>
          </StateTransition>
        </AnimationState>
        <AnimationState x="400" y="200" animationId="0:83" id="0:13">
          <StateTransition stateToId="0:10" duration="150">
            <TransitionViewModelCondition>
              <TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:44" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator>
              <TransitionValueEnumComparator value="0:50"/>
            </TransitionViewModelCondition>
          </StateTransition>
          <StateTransition stateToId="0:11" duration="150">
            <TransitionViewModelCondition>
              <TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:44" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator>
              <TransitionValueEnumComparator value="0:51"/>
            </TransitionViewModelCondition>
          </StateTransition>
          <StateTransition stateToId="0:12" duration="150">
            <TransitionViewModelCondition>
              <TransitionPropertyViewModelComparator><BindablePropertyEnum><DataBindContext sourcePathIds="0:40-0:44" propertyKey="637"/></BindablePropertyEnum></TransitionPropertyViewModelComparator>
              <TransitionValueEnumComparator value="0:52"/>
            </TransitionViewModelCondition>
          </StateTransition>
        </AnimationState>
      </StateMachineLayer>
    </StateMachine>

    <!-- Hold poses: which label shows, and how bright the ring reads. -->
    <LinearAnimation fps="60" duration="1" name="Ready" id="0:80">
      <KeyedObject objectId="0:30"><KeyedProperty propertyKey="18"><KeyFrameDouble value="1"/></KeyedProperty></KeyedObject>
      <KeyedObject objectId="0:32"><KeyedProperty propertyKey="18"><KeyFrameDouble value="0"/></KeyedProperty></KeyedObject>
      <KeyedObject objectId="0:34"><KeyedProperty propertyKey="18"><KeyFrameDouble value="0"/></KeyedProperty></KeyedObject>
