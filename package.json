{
  "name": "universal-spatial-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Five-screen Expo + Next.js reference app: native UI, Rive and Viro across phone, web and headsets.",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.15.0 <26"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "gen": "node tooling/generators/gen.mjs",
    "spatial:prepare-web": "node tooling/copy-viro-web-assets.mjs",
    "skia:prepare-web": "node tooling/copy-skia-web-assets.mjs",
    "postinstall": "node tooling/copy-viro-web-assets.mjs && node tooling/copy-skia-web-assets.mjs && node tooling/copy-rive-web-runtime.mjs",
    "spatial:verify-android": "node tooling/verify-spatial-android.mjs",
    "spatial:verify-typegpu": "node tooling/verify-typegpu-toolchain.mjs",
    "verify:routes": "node tooling/verify-five-routes.mjs",
    "rive:build": "node tooling/build-rive.mjs",
    "verify:rive": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tooling/verify-rive-assets.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "turbo": "catalog:"
  }
}
